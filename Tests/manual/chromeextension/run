#!/bin/bash
# The Clockin Chrome extension in real Chrome, headless, with a throwaway
# profile: picking the buttons, the watcher's registration, and the
# clockin:// links for a one-button (toggle) site and a two-button site.
# Needs Google Chrome and Node. Run from the repository root:
#   bash Tests/manual/chromeextension/run
set -euo pipefail
cd "$(dirname "$0")/../../.."
work="$(mktemp -d "${TMPDIR:-/tmp}/clockin-chrome-ext.XXXXXX")"
trap 'kill "${server:-0}" 2>/dev/null || true; rm -rf "$work"' EXIT
cp -R ClockinMac/ChromeExtension "$work/ext"
# Test copy only: host access without Chrome's permission prompt, and an icon.
python3 - "$work/ext/manifest.json" <<'PY'
import json, sys
path = sys.argv[1]
manifest = json.load(open(path))
manifest['host_permissions'] = ['http://localhost/*']
json.dump(manifest, open(path, 'w'), indent=2)
PY
for size in 16 32 48 128; do
    sips -s format png -z $size $size website/dist/assets/clockin-icon.png --out "$work/ext/icon$size.png" >/dev/null
done
# A second copy that announces commands without opening clockin:// links.
cp -R "$work/ext" "$work/ext-logic"
sed -i '' "s#frame.src = 'clockin://' + action;#/* checks: no link */#" "$work/ext-logic/watch.js"
grep -q "no link" "$work/ext-logic/watch.js"
port=$((20000 + RANDOM % 20000))
python3 -m http.server "$port" --bind 127.0.0.1 --directory Tests/manual/chromeextension/site >/dev/null 2>&1 &
server=$!
sleep 1
node Tests/manual/chromeextension/run.mjs "$work/ext-logic" "http://localhost:$port/toggle.html" toggle logic
node Tests/manual/chromeextension/run.mjs "$work/ext-logic" "http://localhost:$port/two.html" two logic
node Tests/manual/chromeextension/run.mjs "$work/ext-logic" "http://localhost:$port/reload.html" reload logic
node Tests/manual/chromeextension/run.mjs "$work/ext-logic" "http://localhost:$port/div.html" div logic
node Tests/manual/chromeextension/run.mjs "$work/ext-logic" "http://localhost:$port/shift.html" shift logic
node Tests/manual/chromeextension/run.mjs "$work/ext" "http://localhost:$port/toggle.html" toggle link
# The native path needs a Debug build; it runs against the Debug app's own data.
debug_app="build/DerivedData/Build/Products/Debug/Clockin.app"
if [ -x "$debug_app/Contents/MacOS/Clockin" ]; then
    node Tests/manual/chromeextension/run.mjs "$work/ext" "http://localhost:$port/toggle.html" toggle native "$PWD/$debug_app/Contents/MacOS/Clockin"
    # The host launched the Debug app to deliver the presses.
    pkill -f "$PWD/$debug_app/Contents/MacOS/Clockin" || true
else
    echo "skipped the native messaging run: build the Debug app first"
fi
echo "Chrome extension checks passed"
