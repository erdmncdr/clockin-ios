#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../../.."
sources=(Shared/Core/AppLanguage.swift Shared/Core/Models.swift Shared/Core/ClockStore.swift
 Shared/Core/WardrobeBackup.swift Shared/Core/ImportComparison.swift Shared/Core/PastedTextImporter.swift
 Shared/Core/CSVImporter.swift Shared/Core/SessionOverlap.swift
 Clockin/Views/Components/RollingNumber.swift Clockin/Views/Components/RollingNumberFont.swift
 Clockin/Privacy/TimerPersistenceAlert.swift ClockinMac/MenuBarIcon.swift)
swiftc -swift-version 6 -strict-concurrency=complete -warnings-as-errors -parse-as-library \
 -module-cache-path /tmp/clockin24-platform-cache "${sources[@]}" Tests/manual/crashaudit/platform.swift \
 -o /tmp/clockin24-platform-tests
/tmp/clockin24-platform-tests
xcrun --sdk iphonesimulator swiftc -swift-version 6 -strict-concurrency=complete -warnings-as-errors \
 -module-cache-path /tmp/clockin24-platform-cache -target arm64-apple-ios17.0-simulator \
 -sdk "$(xcrun --sdk iphonesimulator --show-sdk-path)" -typecheck "${sources[@]:0:11}"
echo 'PASS iOS rolling font and explicit timer alert SDK check'
