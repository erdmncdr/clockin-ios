#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../../.."
sources=(Shared/Core/AppLanguage.swift Shared/Core/Models.swift Shared/Mascot/Wardrobe.swift
 Shared/Mascot/WardrobeCatalog.swift Shared/Mascot/MascotMotion.swift Shared/Mascot/RoomArrangement.swift
 Shared/Mascot/RoomPlacement.swift Shared/Mascot/HomeSceneLayout.swift)
for source in Shared/Sync/Cloud/*.swift; do
  [[ "$source" == *CloudKitAdapter.swift ]] || sources+=("$source")
done
if [[ "${1:-}" == "typecheck" ]]; then
  for target in 'macosx arm64-apple-macosx14.0' 'iphonesimulator arm64-apple-ios17.0-simulator'; do
    read -r sdk triple <<< "$target"
    xcrun --sdk "$sdk" swiftc -swift-version 6 -strict-concurrency=complete -warnings-as-errors \
      -module-cache-path /tmp/clockin-sync-module-cache -sdk "$(xcrun --sdk "$sdk" --show-sdk-path)" \
      -target "$triple" -typecheck "${sources[@]}" Shared/Sync/Cloud/CloudKitAdapter.swift
    echo "PASS CloudKit adapter: $sdk ($triple)"
  done
elif [[ "${1:-}" == "codec" ]]; then
  swiftc -swift-version 6 -strict-concurrency=complete -warnings-as-errors \
    -module-cache-path /tmp/clockin-sync-module-cache "${sources[@]}" Shared/Sync/Cloud/CloudKitAdapter.swift \
    Tests/manual/sync/cloud/main.swift -o /tmp/clockin-sync-codec-tests
  /tmp/clockin-sync-codec-tests
else
  swiftc -swift-version 6 -strict-concurrency=complete -warnings-as-errors \
    -module-cache-path /tmp/clockin-sync-module-cache "${sources[@]}" Tests/manual/sync/BoundedChecks.swift Tests/manual/sync/main.swift -o /tmp/clockin-sync-tests
  /tmp/clockin-sync-tests "${@:1}"
fi
