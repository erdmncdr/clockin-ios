<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- iPhone'da ozel animasyonlar bu anahtar olmadan 60 Hz'de kalir.
         Kaydirma zaten 120 Hz; dokunma geri bildirimi, sayilar ve gecisler
         de ProMotion ekranda ayni akicilikta olsun. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
