<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    <key>ClockinLiveActivityEndpoint</key>
    <string>https://getclockin.netlify.app/api/v1/live-activity</string>
    <!-- iPhone'da ozel animasyonlar bu anahtar olmadan 60 Hz'de kalir.
         Kaydirma zaten 120 Hz; dokunma geri bildirimi, sayilar ve gecisler
         de ProMotion ekranda ayni akicilikta olsun. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- Yalnizca standart HTTPS kullaniliyor (kur API'si, radyo akisi); her
         yuklemede sifreleme sorusu sorulmasin. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
