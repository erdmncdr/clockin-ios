{
  "manifest_version": 3,
  "name": "Pulse",
  "version": "1.4",
  "description": "Notices two buttons you pick on one site.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pulse",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
