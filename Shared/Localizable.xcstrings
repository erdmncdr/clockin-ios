    },
    "Tone": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton"
          }
        }
      }
    },
    "Total XP": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam XP"
          }
        }
      }
    },
    "Total earnings": {
      "localizations": {
        "tr": {
          "stringUnit": {
