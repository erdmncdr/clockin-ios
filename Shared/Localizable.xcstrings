        }
      }
    },
    "Clockin checks the server connection when your timer is running. No test session is needed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayaç çalışırken Clockin sunucu bağlantısını denetler. Deneme oturumu gerekmez."
          }
        }
      }
    },
    "Clockin has been running for %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clockin %@ süredir çalışıyor."
          }
        }
      }
    },
    "Clockin sends only a temporary notification address and its expiry to Netlify in the US. Apple delivers time signals; your device calculates earnings. The registration lasts up to 8 hours. You can turn this off here to stop updates and request deletion. Pay, earnings and notes are not sent to this server.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clockin, ABD'deki Netlify'a yalnızca geçici bir bildirim adresi ve bu adresin sona erme zamanını gönderir. Zaman sinyallerini Apple iletir; kazancı cihazın hesaplar. Kayıt en fazla 8 saat sürer. Güncellemeleri durdurup silinmesini istemek için bunu buradan kapatabilirsin. Ücret, kazanç ve notlar bu sunucuya gönderilmez."
          }
        }
      }
    },
