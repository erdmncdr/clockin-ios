            "value": "Toplam kazanç"
          }
        }
      }
    },
    "Track your time": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanını takip et"
          }
        }
      }
    },
    "Trophy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupa"
          }
        }
      }
    },
    "Try it before you choose.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmeden önce dene."
          }
        }
      }
    },
    "Try it in your room": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odanda dene"
          }
        }
      }
    },
    "Try it on": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstünde dene"
          }
        }
      }
    },
    "Turkish flag": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türk bayrağı"
          }
        }
      }
    },
    "Turn it off in Clockin Settings to stop updates and request removal of the temporary server record.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri durdurmak ve geçici sunucu kaydının silinmesini istemek için Clockin Ayarları'ndan kapat."
          }
        }
      }
    },
    "Turn on if your hourly rate changed. Work before the date uses the earlier rate.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatlik ücretin değiştiyse aç. Bu tarihten önceki çalışmalar önceki ücreti kullanır."
          }
        }
      }
    },
    "Turn sideways for a large, always-on work timer.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük ve hep açık bir çalışma sayacı için telefonu yan çevir."
          }
        }
      }
    },
    "Turn the phone sideways for a large timer with live earnings, today's total, your daily goal and the session controls. While a session runs, the screen stays on. Turn it off in Settings if you want Clockin to stay upright.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı kazanç, bugünün toplamı, günlük hedefin ve oturum denetimleriyle büyük bir sayaç için telefonu yan çevir. Oturum sürerken ekran açık kalır. Clockin'in dik kalmasını istiyorsan Ayarlar'dan kapat."
          }
        }
      }
    },
    "Typing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıyor"
          }
        }
      }
    },
    "UPDATE": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GÜNCELLE"
          }
        }
      }
    },
    "USD": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "USD"
          }
        }
      }
    },
    "USD / TRY rate": {
