            "state": "translated",
            "value": "USD / TRY alınamadı"
          }
        }
      }
    },
    "UTF-8 CSV with Start Time and End Time columns containing ISO 8601 dates, such as 2026-09-10T09:00:00Z. Optional columns: Duration (milliseconds), Notes, and Time Sheet Source. Invalid rows are skipped.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 8601 tarihler içeren Start Time ve End Time sütunlarına sahip UTF-8 CSV, örneğin 2026-09-10T09:00:00Z. İsteğe bağlı sütunlar: Duration (milisaniye), Notes ve Time Sheet Source. Geçersiz satırlar atlanır."
          }
        }
      }
    },
