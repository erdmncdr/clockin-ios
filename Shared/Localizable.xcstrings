    "%@. Streams over the internet and keeps playing with the screen locked. Pin it to Today for station, playback and volume controls.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. İnternetten yayın yapar ve ekran kilitliyken çalmaya devam eder. İstasyon, oynatma ve ses denetimleri için Bugün'e sabitle."
          }
        }
      }
    },
