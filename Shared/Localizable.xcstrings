      }
    },
    "I'm not mad. I'm just disappointed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kızgın değilim. Sadece hayal kırıklığına uğradım."
          }
        }
      }
    },
    "If you forgot to start, tap Start with elapsed time on Today while no session is running. Enter hours and minutes, add an optional note, check the preview, then tap Start. The timer continues from that duration.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatmayı unuttuysan, çalışan oturum yokken Bugün'de Geçen süreyle başlat'a dokun. Saat ve dakikayı gir, istersen bir not ekle, önizlemeye bak ve Başlat'a dokun. Sayaç o süreden devam eder."
          }
        }
      }
    },
